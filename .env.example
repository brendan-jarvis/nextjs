# Auth.js (NextAuth). Sign-in uses the GitHub and Google providers.
# Generate a secret with: bunx auth secret
# Callback URLs: {APP_URL}/api/auth/callback/github and /api/auth/callback/google
# Production: https://brendan-jarvis.vercel.app/api/auth/callback/{github,google}
# Google also allows http://localhost:3000/api/auth/callback/google.
# A GitHub OAuth app allows one callback URL, so local GitHub sign-in needs
# a separate dev OAuth app.
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Supabase Postgres. Use the transaction pooler (port 6543). Tables live in
# the "nextjs" schema. Copy the host from Supabase Dashboard > Connect >
# Transaction pooler. A dedicated role is recommended over "postgres":
# DATABASE_URL=postgresql://nextjs_app.uyptmjimpsnlnlwyrzeo:PASSWORD@POOLER_HOST:6543/postgres

# SECURITY: Never commit real secrets. .env and .env*.local are gitignored.
# All DB access is server-side only via Drizzle. See README.

# Optional: skip env validation during build/CI
# SKIP_ENV_VALIDATION=1
